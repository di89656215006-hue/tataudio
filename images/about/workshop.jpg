<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1A1A1A"/>
      <stop offset="100%" style="stop-color:#0D0D0D"/>
    </linearGradient>
  </defs>
  <rect width="600" height="400" fill="url(#bg)"/>
  <!-- Workshop elements -->
  <rect x="50" y="280" width="120" height="80" rx="5" fill="#2A2A2A"/>
  <rect x="200" y="250" width="200" height="110" rx="5" fill="#2A2A2A"/>
  <rect x="430" y="270" width="120" height="90" rx="5" fill="#2A2A2A"/>
  <!-- Tools on wall -->
  <rect x="80" y="100" width="40" height="8" rx="2" fill="#E31E24"/>
  <rect x="140" y="100" width="60" height="8" rx="2" fill="#E31E24"/>
  <circle cx="250" cy="120" r="30" fill="none" stroke="#E31E24" stroke-width="3"/>
  <rect x="320" y="90" width="80" height="60" rx="5" fill="#2A2A2A"/>
  <!-- Car silhouette -->
  <path d="M150,200 Q200,180 300,180 Q400,180 450,200 L460,240 L140,240 Z" fill="#333"/>
  <circle cx="180" cy="240" r="25" fill="#222"/>
  <circle cx="420" cy="240" r="25" fill="#222"/>
  <!-- Text -->
  <text x="300" y="360" font-family="Montserrat, sans-serif" font-size="16" fill="#666" text-anchor="middle">Мастерская ТАТаудио</text>
</svg>
