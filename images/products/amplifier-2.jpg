<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1A1A1A"/>
      <stop offset="100%" style="stop-color:#0D0D0D"/>
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="url(#bg)"/>
  <!-- Mono amplifier body -->
  <rect x="60" y="60" width="280" height="120" rx="8" fill="#222"/>
  <!-- Heatsink fins -->
  <rect x="70" y="70" width="5" height="100" fill="#333"/>
  <rect x="85" y="70" width="5" height="100" fill="#333"/>
  <rect x="100" y="70" width="5" height="100" fill="#333"/>
  <rect x="115" y="70" width="5" height="100" fill="#333"/>
  <rect x="130" y="70" width="5" height="100" fill="#333"/>
  <!-- Logo area -->
  <rect x="150" y="80" width="100" height="40" rx="3" fill="#111"/>
  <text x="200" y="105" font-family="sans-serif" font-size="14" fill="#E31E24" text-anchor="middle">AUDISON</text>
  <!-- Controls -->
  <circle cx="170" cy="145" r="8" fill="#333"/>
  <circle cx="200" cy="145" r="8" fill="#333"/>
  <circle cx="230" cy="145" r="8" fill="#333"/>
  <!-- Power indicator -->
  <circle cx="270" cy="145" r="5" fill="#E31E24"/>
  <!-- Terminals -->
  <rect x="280" y="80" width="50" height="80" rx="3" fill="#111"/>
  <circle cx="295" cy="100" r="8" fill="#E31E24"/>
  <circle cx="315" cy="100" r="8" fill="#333"/>
  <circle cx="305" cy="130" r="10" fill="#E31E24"/>
  <!-- Price tag -->
  <rect x="120" y="200" width="160" height="30" rx="5" fill="#E31E24"/>
  <text x="200" y="220" font-family="Montserrat, sans-serif" font-size="14" fill="#fff" text-anchor="middle">25 900 ₽</text>
  <!-- Text -->
  <text x="200" y="270" font-family="Montserrat, sans-serif" font-size="12" fill="#666" text-anchor="middle">Моноблок D-класса</text>
</svg>
