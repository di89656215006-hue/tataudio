<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1A1A1A"/>
      <stop offset="100%" style="stop-color:#0D0D0D"/>
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="url(#bg)"/>
  <!-- Subwoofer box -->
  <rect x="80" y="60" width="240" height="160" rx="10" fill="#222"/>
  <!-- Speaker grille -->
  <circle cx="200" cy="140" r="70" fill="#111"/>
  <circle cx="200" cy="140" r="55" fill="#1a1a1a"/>
  <circle cx="200" cy="140" r="25" fill="#E31E24"/>
  <!-- Grille pattern -->
  <line x1="140" y1="140" x2="260" y2="140" stroke="#333" stroke-width="1"/>
  <line x1="200" y1="80" x2="200" y2="200" stroke="#333" stroke-width="1"/>
  <!-- Port -->
  <rect x="300" y="100" width="20" height="60" rx="5" fill="#111"/>
  <!-- Text -->
  <text x="200" y="260" font-family="Montserrat, sans-serif" font-size="14" fill="#666" text-anchor="middle">Сабвуферы</text>
</svg>
