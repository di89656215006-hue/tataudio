<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1A1A1A"/>
      <stop offset="100%" style="stop-color:#0D0D0D"/>
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="url(#bg)"/>
  <!-- Speaker -->
  <circle cx="200" cy="110" r="70" fill="#222"/>
  <circle cx="200" cy="110" r="55" fill="#333"/>
  <circle cx="200" cy="110" r="40" fill="#222"/>
  <circle cx="200" cy="110" r="20" fill="#E31E24"/>
  <circle cx="200" cy="110" r="10" fill="#111"/>
  <!-- Mounting holes -->
  <circle cx="200" cy="30" r="5" fill="#111"/>
  <circle cx="200" cy="190" r="5" fill="#111"/>
  <circle cx="120" cy="110" r="5" fill="#111"/>
  <circle cx="280" cy="110" r="5" fill="#111"/>
  <!-- Price tag -->
  <rect x="120" y="200" width="160" height="30" rx="5" fill="#E31E24"/>
  <text x="200" y="220" font-family="Montserrat, sans-serif" font-size="14" fill="#fff" text-anchor="middle">4 500 ₽</text>
  <!-- Text -->
  <text x="200" y="270" font-family="Montserrat, sans-serif" font-size="12" fill="#666" text-anchor="middle">Коаксиальная акустика</text>
</svg>
