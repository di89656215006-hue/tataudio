<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1A1A1A"/>
      <stop offset="100%" style="stop-color:#0D0D0D"/>
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="url(#bg)"/>
  <!-- Component speaker woofer -->
  <circle cx="150" cy="100" r="60" fill="#222"/>
  <circle cx="150" cy="100" r="45" fill="#333"/>
  <circle cx="150" cy="100" r="30" fill="#222"/>
  <circle cx="150" cy="100" r="15" fill="#E31E24"/>
  <!-- Tweeter -->
  <circle cx="280" cy="80" r="30" fill="#222"/>
  <circle cx="280" cy="80" r="20" fill="#333"/>
  <circle cx="280" cy="80" r="10" fill="#E31E24"/>
  <!-- Crossover -->
  <rect x="250" y="130" width="80" height="50" rx="5" fill="#222"/>
  <text x="290" y="160" font-family="sans-serif" font-size="10" fill="#E31E24" text-anchor="middle">X-OVER</text>
  <!-- Price tag -->
  <rect x="120" y="200" width="160" height="30" rx="5" fill="#E31E24"/>
  <text x="200" y="220" font-family="Montserrat, sans-serif" font-size="14" fill="#fff" text-anchor="middle">7 900 ₽</text>
  <!-- Text -->
  <text x="200" y="270" font-family="Montserrat, sans-serif" font-size="12" fill="#666" text-anchor="middle">Компонентная акустика</text>
</svg>
