<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1A1A1A"/>
      <stop offset="100%" style="stop-color:#0D0D0D"/>
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="url(#bg)"/>
  <!-- Subwoofer -->
  <circle cx="200" cy="100" r="80" fill="#222"/>
  <circle cx="200" cy="100" r="65" fill="#333"/>
  <circle cx="200" cy="100" r="50" fill="#222"/>
  <circle cx="200" cy="100" r="25" fill="#E31E24"/>
  <circle cx="200" cy="100" r="12" fill="#111"/>
  <!-- Surround ring -->
  <circle cx="200" cy="100" r="75" fill="none" stroke="#444" stroke-width="8"/>
  <!-- Price tag -->
  <rect x="120" y="200" width="160" height="30" rx="5" fill="#E31E24"/>
  <text x="200" y="220" font-family="Montserrat, sans-serif" font-size="14" fill="#fff" text-anchor="middle">15 500 ₽</text>
  <!-- Text -->
  <text x="200" y="270" font-family="Montserrat, sans-serif" font-size="12" fill="#666" text-anchor="middle">Сабвуфер 12"</text>
</svg>
