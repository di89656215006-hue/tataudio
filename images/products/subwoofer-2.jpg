<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1A1A1A"/>
      <stop offset="100%" style="stop-color:#0D0D0D"/>
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="url(#bg)"/>
  <!-- Active subwoofer box -->
  <rect x="80" y="40" width="240" height="150" rx="10" fill="#222"/>
  <!-- Subwoofer -->
  <circle cx="200" cy="100" r="55" fill="#333"/>
  <circle cx="200" cy="100" r="40" fill="#222"/>
  <circle cx="200" cy="100" r="20" fill="#E31E24"/>
  <circle cx="200" cy="100" r="8" fill="#111"/>
  <!-- Port -->
  <ellipse cx="320" cy="100" rx="15" ry="25" fill="#111"/>
  <!-- Amp built-in -->
  <rect x="90" y="150" width="60" height="30" rx="3" fill="#111"/>
  <text x="120" y="170" font-family="sans-serif" font-size="8" fill="#E31E24" text-anchor="middle">AMP</text>
  <!-- Price tag -->
  <rect x="120" y="210" width="160" height="30" rx="5" fill="#E31E24"/>
  <text x="200" y="230" font-family="Montserrat, sans-serif" font-size="14" fill="#fff" text-anchor="middle">22 900 ₽</text>
  <!-- Text -->
  <text x="200" y="280" font-family="Montserrat, sans-serif" font-size="12" fill="#666" text-anchor="middle">Активный сабвуфер</text>
</svg>
