<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1A1A1A"/>
      <stop offset="100%" style="stop-color:#0D0D0D"/>
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="url(#bg)"/>
  <!-- Head unit 2 -->
  <rect x="100" y="60" width="200" height="100" rx="8" fill="#222"/>
  <rect x="110" y="70" width="180" height="70" rx="5" fill="#111"/>
  <!-- Display -->
  <rect x="120" y="80" width="160" height="50" rx="3" fill="#1a1a2e"/>
  <text x="200" y="110" font-family="sans-serif" font-size="12" fill="#E31E24" text-anchor="middle">ALPINE</text>
  <!-- Buttons -->
  <circle cx="130" cy="145" r="6" fill="#333"/>
  <circle cx="150" cy="145" r="6" fill="#333"/>
  <circle cx="250" cy="145" r="6" fill="#333"/>
  <circle cx="270" cy="145" r="6" fill="#333"/>
  <!-- Knob -->
  <circle cx="300" cy="110" r="15" fill="#333" stroke="#E31E24" stroke-width="2"/>
  <!-- Price tag -->
  <rect x="120" y="180" width="160" height="30" rx="5" fill="#E31E24"/>
  <text x="200" y="200" font-family="Montserrat, sans-serif" font-size="14" fill="#fff" text-anchor="middle">12 900 ₽</text>
  <!-- Text -->
  <text x="200" y="250" font-family="Montserrat, sans-serif" font-size="12" fill="#666" text-anchor="middle">Автомагнитола 2DIN</text>
</svg>
