<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1A1A1A"/>
      <stop offset="100%" style="stop-color:#0D0D0D"/>
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="url(#bg)"/>
  <!-- Speaker -->
  <circle cx="200" cy="130" r="80" fill="#222"/>
  <circle cx="200" cy="130" r="60" fill="#111"/>
  <circle cx="200" cy="130" r="40" fill="#1a1a1a"/>
  <circle cx="200" cy="130" r="15" fill="#E31E24"/>
  <!-- Cone pattern -->
  <circle cx="200" cy="130" r="50" fill="none" stroke="#333" stroke-width="1"/>
  <circle cx="200" cy="130" r="35" fill="none" stroke="#333" stroke-width="1"/>
  <!-- Mounting holes -->
  <circle cx="200" cy="60" r="5" fill="#333"/>
  <circle cx="200" cy="200" r="5" fill="#333"/>
  <circle cx="130" cy="130" r="5" fill="#333"/>
  <circle cx="270" cy="130" r="5" fill="#333"/>
  <!-- Text -->
  <text x="200" y="260" font-family="Montserrat, sans-serif" font-size="14" fill="#666" text-anchor="middle">Акустика</text>
</svg>
