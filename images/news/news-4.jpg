<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1A1A1A"/>
      <stop offset="100%" style="stop-color:#0D0D0D"/>
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="url(#bg)"/>
  <!-- Partnership handshake -->
  <path d="M100,120 L150,100 L200,120 L200,150 L150,170 L100,150 Z" fill="#222"/>
  <path d="M200,120 L250,100 L300,120 L300,150 L250,170 L200,150 Z" fill="#333"/>
  <!-- Hands -->
  <rect x="120" y="130" width="80" height="20" rx="5" fill="#E31E24"/>
  <rect x="200" y="130" width="80" height="20" rx="5" fill="#E31E24"/>
  <!-- Partner logos -->
  <rect x="80" y="180" width="60" height="30" rx="3" fill="#222"/>
  <text x="110" y="200" font-family="sans-serif" font-size="10" fill="#E31E24" text-anchor="middle">PIONEER</text>
  <rect x="160" y="180" width="60" height="30" rx="3" fill="#222"/>
  <text x="190" y="200" font-family="sans-serif" font-size="10" fill="#E31E24" text-anchor="middle">ALPINE</text>
  <rect x="240" y="180" width="60" height="30" rx="3" fill="#222"/>
  <text x="270" y="200" font-family="sans-serif" font-size="10" fill="#E31E24" text-anchor="middle">HERTZ</text>
  <!-- Text -->
  <text x="200" y="240" font-family="Montserrat, sans-serif" font-size="14" fill="#666" text-anchor="middle">Новое партнерство</text>
  <text x="200" y="260" font-family="Montserrat, sans-serif" font-size="12" fill="#E31E24" text-anchor="middle">Апрель 2026</text>
</svg>
