<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1A1A1A"/>
      <stop offset="100%" style="stop-color:#0D0D0D"/>
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="url(#bg)"/>
  <!-- Anniversary -->
  <circle cx="200" cy="100" r="60" fill="#222" stroke="#E31E24" stroke-width="3"/>
  <text x="200" y="90" font-family="Montserrat, sans-serif" font-size="36" fill="#E31E24" text-anchor="middle">10</text>
  <text x="200" y="115" font-family="Montserrat, sans-serif" font-size="12" fill="#fff" text-anchor="middle">ЛЕТ</text>
  <!-- Stars -->
  <polygon points="120,100 123,108 132,108 125,113 128,122 120,117 112,122 115,113 108,108 117,108" fill="#E31E24"/>
  <polygon points="280,100 283,108 292,108 285,113 288,122 280,117 272,122 275,113 268,108 277,108" fill="#E31E24"/>
  <!-- Confetti -->
  <rect x="100" y="160" width="8" height="8" fill="#E31E24" transform="rotate(45 104 164)"/>
  <rect x="150" y="170" width="6" height="6" fill="#fff" transform="rotate(30 153 173)"/>
  <rect x="240" y="165" width="8" height="8" fill="#E31E24" transform="rotate(60 244 169)"/>
  <rect x="290" y="175" width="6" height="6" fill="#fff" transform="rotate(15 293 178)"/>
  <!-- Text -->
  <text x="200" y="220" font-family="Montserrat, sans-serif" font-size="14" fill="#666" text-anchor="middle">Юбилей компании</text>
  <text x="200" y="240" font-family="Montserrat, sans-serif" font-size="12" fill="#E31E24" text-anchor="middle">Август 2026</text>
</svg>
