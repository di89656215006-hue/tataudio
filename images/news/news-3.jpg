<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1A1A1A"/>
      <stop offset="100%" style="stop-color:#0D0D0D"/>
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="url(#bg)"/>
  <!-- Workshop icon -->
  <rect x="100" y="80" width="200" height="120" rx="5" fill="#222"/>
  <!-- Tools -->
  <rect x="120" y="100" width="60" height="10" rx="2" fill="#E31E24"/>
  <circle cx="120" cy="105" r="8" fill="#333"/>
  <rect x="200" y="100" width="60" height="10" rx="2" fill="#E31E24"/>
  <circle cx="260" cy="105" r="8" fill="#333"/>
  <!-- Car silhouette -->
  <path d="M140,140 L260,140 L250,170 L150,170 Z" fill="#333"/>
  <circle cx="165" cy="170" r="12" fill="#222"/>
  <circle cx="235" cy="170" r="12" fill="#222"/>
  <!-- Sound waves -->
  <path d="M280,130 Q300,140 280,150" stroke="#E31E24" stroke-width="3" fill="none"/>
  <path d="M290,120 Q320,140 290,160" stroke="#E31E24" stroke-width="3" fill="none"/>
  <!-- Text -->
  <text x="200" y="230" font-family="Montserrat, sans-serif" font-size="14" fill="#666" text-anchor="middle">Открытие нового цеха</text>
  <text x="200" y="250" font-family="Montserrat, sans-serif" font-size="12" fill="#E31E24" text-anchor="middle">Март 2026</text>
</svg>
