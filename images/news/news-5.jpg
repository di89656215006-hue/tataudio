<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1A1A1A"/>
      <stop offset="100%" style="stop-color:#0D0D0D"/>
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="url(#bg)"/>
  <!-- Certificate -->
  <rect x="120" y="50" width="160" height="120" rx="5" fill="#222" stroke="#E31E24" stroke-width="2"/>
  <rect x="130" y="60" width="140" height="30" fill="#E31E24"/>
  <text x="200" y="82" font-family="Montserrat, sans-serif" font-size="12" fill="#fff" text-anchor="middle">СЕРТИФИКАТ</text>
  <!-- Lines -->
  <rect x="140" y="100" width="120" height="5" rx="2" fill="#333"/>
  <rect x="140" y="115" width="100" height="5" rx="2" fill="#333"/>
  <rect x="140" y="130" width="80" height="5" rx="2" fill="#333"/>
  <!-- Seal -->
  <circle cx="250" cy="150" r="15" fill="#E31E24"/>
  <text x="250" y="155" font-family="sans-serif" font-size="8" fill="#fff" text-anchor="middle">✓</text>
  <!-- Text -->
  <text x="200" y="200" font-family="Montserrat, sans-serif" font-size="14" fill="#666" text-anchor="middle">Сертификация</text>
  <text x="200" y="220" font-family="Montserrat, sans-serif" font-size="12" fill="#E31E24" text-anchor="middle">Май 2026</text>
</svg>
