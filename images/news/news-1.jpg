<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1A1A1A"/>
      <stop offset="100%" style="stop-color:#0D0D0D"/>
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="url(#bg)"/>
  <!-- News icon -->
  <rect x="140" y="60" width="120" height="100" rx="8" fill="#222"/>
  <rect x="150" y="70" width="100" height="15" rx="3" fill="#E31E24"/>
  <rect x="150" y="95" width="80" height="8" rx="2" fill="#333"/>
  <rect x="150" y="110" width="100" height="8" rx="2" fill="#333"/>
  <rect x="150" y="125" width="60" height="8" rx="2" fill="#333"/>
  <rect x="150" y="140" width="90" height="8" rx="2" fill="#333"/>
  <!-- Calendar icon -->
  <rect x="170" y="180" width="60" height="50" rx="5" fill="#222"/>
  <rect x="170" y="180" width="60" height="15" rx="5" fill="#E31E24"/>
  <text x="200" y="215" font-family="Montserrat, sans-serif" font-size="18" fill="#fff" text-anchor="middle">15</text>
  <!-- Text -->
  <text x="200" y="260" font-family="Montserrat, sans-serif" font-size="14" fill="#666" text-anchor="middle">Новое поступление</text>
  <text x="200" y="280" font-family="Montserrat, sans-serif" font-size="12" fill="#E31E24" text-anchor="middle">Январь 2026</text>
</svg>
