<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1A1A1A"/>
      <stop offset="100%" style="stop-color:#0D0D0D"/>
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="url(#bg)"/>
  <!-- Event/Seminar -->
  <rect x="100" y="60" width="200" height="130" rx="8" fill="#222"/>
  <!-- Screen -->
  <rect x="120" y="80" width="160" height="80" rx="3" fill="#111"/>
  <!-- Presentation content -->
  <rect x="130" y="90" width="60" height="30" rx="2" fill="#E31E24"/>
  <rect x="200" y="90" width="70" height="10" rx="2" fill="#333"/>
  <rect x="200" y="105" width="50" height="8" rx="2" fill="#333"/>
  <rect x="130" y="130" width="140" height="20" rx="2" fill="#333"/>
  <!-- Audience -->
  <circle cx="140" cy="175" r="10" fill="#333"/>
  <circle cx="170" cy="175" r="10" fill="#333"/>
  <circle cx="200" cy="175" r="10" fill="#333"/>
  <circle cx="230" cy="175" r="10" fill="#333"/>
  <circle cx="260" cy="175" r="10" fill="#333"/>
  <!-- Text -->
  <text x="200" y="220" font-family="Montserrat, sans-serif" font-size="14" fill="#666" text-anchor="middle">Мастер-класс</text>
  <text x="200" y="240" font-family="Montserrat, sans-serif" font-size="12" fill="#E31E24" text-anchor="middle">Июнь 2026</text>
</svg>
