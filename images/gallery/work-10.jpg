<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1A1A1A"/>
      <stop offset="100%" style="stop-color:#0D0D0D"/>
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="url(#bg)"/>
  <!-- Rear deck -->
  <rect x="50" y="60" width="300" height="160" rx="10" fill="#222"/>
  <!-- Rear speakers -->
  <circle cx="120" cy="120" r="35" fill="#333"/>
  <circle cx="120" cy="120" r="25" fill="#222"/>
  <circle cx="120" cy="120" r="12" fill="#E31E24"/>
  <circle cx="280" cy="120" r="35" fill="#333"/>
  <circle cx="280" cy="120" r="25" fill="#222"/>
  <circle cx="280" cy="120" r="12" fill="#E31E24"/>
  <!-- Center brake light -->
  <rect x="170" y="180" width="60" height="20" rx="5" fill="#E31E24"/>
  <!-- Grille fabric -->
  <rect x="80" y="90" width="80" height="60" rx="5" fill="none" stroke="#444" stroke-width="1"/>
  <rect x="240" y="90" width="80" height="60" rx="5" fill="none" stroke="#444" stroke-width="1"/>
  <!-- Text -->
  <text x="200" y="245" font-family="Montserrat, sans-serif" font-size="12" fill="#666" text-anchor="middle">Установка задней акустики</text>
  <text x="200" y="265" font-family="Montserrat, sans-serif" font-size="10" fill="#E31E24" text-anchor="middle">Mazda CX-5</text>
</svg>
