<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1A1A1A"/>
      <stop offset="100%" style="stop-color:#0D0D0D"/>
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="url(#bg)"/>
  <!-- Complete system -->
  <rect x="50" y="40" width="300" height="180" rx="10" fill="#222"/>
  <!-- Head unit -->
  <rect x="70" y="60" width="80" height="50" rx="5" fill="#111"/>
  <rect x="75" y="65" width="70" height="35" rx="3" fill="#1a1a2e"/>
  <text x="110" y="88" font-family="sans-serif" font-size="8" fill="#E31E24" text-anchor="middle">ALPINE</text>
  <!-- DSP -->
  <rect x="170" y="60" width="60" height="40" rx="3" fill="#333"/>
  <text x="200" y="85" font-family="sans-serif" font-size="8" fill="#E31E24" text-anchor="middle">DSP</text>
  <!-- Amplifiers -->
  <rect x="250" y="60" width="80" height="35" rx="3" fill="#333"/>
  <text x="290" y="82" font-family="sans-serif" font-size="8" fill="#E31E24" text-anchor="middle">AMP 1</text>
  <rect x="250" y="100" width="80" height="35" rx="3" fill="#333"/>
  <text x="290" y="122" font-family="sans-serif" font-size="8" fill="#E31E24" text-anchor="middle">AMP 2</text>
  <!-- Speakers -->
  <circle cx="100" cy="160" r="25" fill="#333"/>
  <circle cx="100" cy="160" r="15" fill="#222"/>
  <circle cx="100" cy="160" r="6" fill="#E31E24"/>
  <circle cx="200" cy="160" r="25" fill="#333"/>
  <circle cx="200" cy="160" r="15" fill="#222"/>
  <circle cx="200" cy="160" r="6" fill="#E31E24"/>
  <circle cx="300" cy="160" r="25" fill="#333"/>
  <circle cx="300" cy="160" r="15" fill="#222"/>
  <circle cx="300" cy="160" r="6" fill="#E31E24"/>
  <!-- Wiring -->
  <path d="M110,110 L110,135 L300,135 L300,135" stroke="#E31E24" stroke-width="1" fill="none"/>
  <!-- Text -->
  <text x="200" y="240" font-family="Montserrat, sans-serif" font-size="12" fill="#666" text-anchor="middle">Полный аудиокомплекс</text>
  <text x="200" y="260" font-family="Montserrat, sans-serif" font-size="10" fill="#E31E24" text-anchor="middle">Range Rover</text>
</svg>
