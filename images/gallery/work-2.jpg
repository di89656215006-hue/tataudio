<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1A1A1A"/>
      <stop offset="100%" style="stop-color:#0D0D0D"/>
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="url(#bg)"/>
  <!-- Trunk with subwoofer -->
  <rect x="50" y="50" width="300" height="170" rx="10" fill="#222"/>
  <!-- Subwoofer box -->
  <rect x="100" y="80" width="200" height="100" rx="8" fill="#333"/>
  <!-- Subwoofer -->
  <circle cx="200" cy="130" r="40" fill="#222"/>
  <circle cx="200" cy="130" r="30" fill="#333"/>
  <circle cx="200" cy="130" r="18" fill="#E31E24"/>
  <circle cx="200" cy="130" r="8" fill="#111"/>
  <!-- Amplifier -->
  <rect x="280" y="90" width="60" height="80" rx="5" fill="#222"/>
  <text x="310" y="135" font-family="sans-serif" font-size="8" fill="#E31E24" text-anchor="middle">AMP</text>
  <!-- LED strips -->
  <rect x="100" y="185" width="200" height="3" fill="#E31E24"/>
  <!-- Text -->
  <text x="200" y="240" font-family="Montserrat, sans-serif" font-size="12" fill="#666" text-anchor="middle">Установка сабвуфера</text>
  <text x="200" y="260" font-family="Montserrat, sans-serif" font-size="10" fill="#E31E24" text-anchor="middle">BMW X5</text>
</svg>
