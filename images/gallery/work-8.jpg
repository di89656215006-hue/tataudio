<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1A1A1A"/>
      <stop offset="100%" style="stop-color:#0D0D0D"/>
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="url(#bg)"/>
  <!-- Floor pan -->
  <rect x="50" y="80" width="300" height="140" rx="10" fill="#222"/>
  <!-- Sound deadening layers -->
  <rect x="70" y="100" width="120" height="80" rx="5" fill="#333" stroke="#E31E24" stroke-width="1"/>
  <rect x="210" y="100" width="120" height="80" rx="5" fill="#333" stroke="#E31E24" stroke-width="1"/>
  <!-- Rollers -->
  <rect x="100" y="190" width="20" height="40" rx="3" fill="#E31E24"/>
  <rect x="240" y="190" width="20" height="40" rx="3" fill="#E31E24"/>
  <!-- Material rolls -->
  <ellipse cx="350" cy="120" rx="20" ry="30" fill="#333"/>
  <ellipse cx="350" cy="120" rx="15" ry="25" fill="#444"/>
  <!-- Text -->
  <text x="200" y="250" font-family="Montserrat, sans-serif" font-size="12" fill="#666" text-anchor="middle">Шумоизоляция пола</text>
  <text x="200" y="270" font-family="Montserrat, sans-serif" font-size="10" fill="#E31E24" text-anchor="middle">Volkswagen Tiguan</text>
</svg>
