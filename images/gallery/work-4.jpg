<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1A1A1A"/>
      <stop offset="100%" style="stop-color:#0D0D0D"/>
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="url(#bg)"/>
  <!-- Sound deadening material -->
  <rect x="60" y="50" width="280" height="170" rx="10" fill="#222"/>
  <!-- Butyl material sheets -->
  <rect x="80" y="70" width="100" height="60" rx="5" fill="#333"/>
  <rect x="80" y="70" width="100" height="60" rx="5" fill="none" stroke="#E31E24" stroke-width="1"/>
  <rect x="200" y="70" width="100" height="60" rx="5" fill="#333"/>
  <rect x="200" y="70" width="100" height="60" rx="5" fill="none" stroke="#E31E24" stroke-width="1"/>
  <rect x="80" y="145" width="100" height="60" rx="5" fill="#333"/>
  <rect x="80" y="145" width="100" height="60" rx="5" fill="none" stroke="#E31E24" stroke-width="1"/>
  <rect x="200" y="145" width="100" height="60" rx="5" fill="#333"/>
  <rect x="200" y="145" width="100" height="60" rx="5" fill="none" stroke="#E31E24" stroke-width="1"/>
  <!-- Roller -->
  <rect x="320" y="100" width="15" height="60" rx="3" fill="#E31E24"/>
  <rect x="317" y="80" width="21" height="25" rx="5" fill="#333"/>
  <!-- Text -->
  <text x="200" y="245" font-family="Montserrat, sans-serif" font-size="12" fill="#666" text-anchor="middle">Шумоизоляция дверей</text>
  <text x="200" y="265" font-family="Montserrat, sans-serif" font-size="10" fill="#E31E24" text-anchor="middle">Audi A6</text>
</svg>
