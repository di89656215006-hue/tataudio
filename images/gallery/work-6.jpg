<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1A1A1A"/>
      <stop offset="100%" style="stop-color:#0D0D0D"/>
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="url(#bg)"/>
  <!-- Custom enclosure -->
  <rect x="60" y="50" width="280" height="170" rx="10" fill="#222"/>
  <!-- Fiberglass enclosure shape -->
  <path d="M100,180 Q100,80 200,80 Q300,80 300,180 Z" fill="#333"/>
  <!-- Subwoofer -->
  <circle cx="200" cy="130" r="45" fill="#222"/>
  <circle cx="200" cy="130" r="35" fill="#333"/>
  <circle cx="200" cy="130" r="20" fill="#E31E24"/>
  <circle cx="200" cy="130" r="8" fill="#111"/>
  <!-- Port -->
  <ellipse cx="280" cy="150" rx="15" ry="25" fill="#111"/>
  <!-- Carpet texture lines -->
  <line x1="80" y1="200" x2="320" y2="200" stroke="#444" stroke-width="1"/>
  <!-- Text -->
  <text x="200" y="240" font-family="Montserrat, sans-serif" font-size="12" fill="#666" text-anchor="middle">Изготовление корпуса</text>
  <text x="200" y="260" font-family="Montserrat, sans-serif" font-size="10" fill="#E31E24" text-anchor="middle">Porsche Cayenne</text>
</svg>
