<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1A1A1A"/>
      <stop offset="100%" style="stop-color:#0D0D0D"/>
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="url(#bg)"/>
  <!-- Android head unit -->
  <rect x="80" y="50" width="240" height="160" rx="10" fill="#222"/>
  <!-- Large display -->
  <rect x="95" y="65" width="210" height="120" rx="5" fill="#111"/>
  <!-- Android interface -->
  <rect x="105" y="75" width="40" height="40" rx="8" fill="#333"/>
  <rect x="155" y="75" width="40" height="40" rx="8" fill="#333"/>
  <rect x="205" y="75" width="40" height="40" rx="8" fill="#333"/>
  <rect x="255" y="75" width="40" height="40" rx="8" fill="#333"/>
  <!-- Navigation bar -->
  <rect x="105" y="130" width="190" height="45" rx="3" fill="#1a1a2e"/>
  <text x="200" y="158" font-family="sans-serif" font-size="10" fill="#E31E24" text-anchor="middle">ANDROID AUTO</text>
  <!-- Buttons -->
  <circle cx="120" cy="195" r="5" fill="#333"/>
  <circle cx="140" cy="195" r="5" fill="#333"/>
  <circle cx="260" cy="195" r="5" fill="#333"/>
  <circle cx="280" cy="195" r="5" fill="#333"/>
  <!-- Text -->
  <text x="200" y="240" font-family="Montserrat, sans-serif" font-size="12" fill="#666" text-anchor="middle">Android-магнитола</text>
  <text x="200" y="260" font-family="Montserrat, sans-serif" font-size="10" fill="#E31E24" text-anchor="middle">Kia K5</text>
</svg>
