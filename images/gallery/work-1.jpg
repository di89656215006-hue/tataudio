<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1A1A1A"/>
      <stop offset="100%" style="stop-color:#0D0D0D"/>
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="url(#bg)"/>
  <!-- Car interior -->
  <rect x="50" y="60" width="300" height="150" rx="10" fill="#222"/>
  <!-- Dashboard -->
  <path d="M70,180 Q200,160 330,180 L330,200 L70,200 Z" fill="#333"/>
  <!-- Head unit -->
  <rect x="160" y="130" width="80" height="45" rx="5" fill="#111"/>
  <rect x="165" y="135" width="70" height="30" rx="3" fill="#1a1a2e"/>
  <text x="200" y="155" font-family="sans-serif" font-size="10" fill="#E31E24" text-anchor="middle">PIONEER</text>
  <!-- Steering wheel -->
  <circle cx="200" cy="100" r="30" fill="none" stroke="#333" stroke-width="8"/>
  <circle cx="200" cy="100" r="10" fill="#222"/>
  <!-- Speakers in doors -->
  <circle cx="90" cy="150" r="20" fill="#333"/>
  <circle cx="90" cy="150" r="12" fill="#222"/>
  <circle cx="90" cy="150" r="5" fill="#E31E24"/>
  <circle cx="310" cy="150" r="20" fill="#333"/>
  <circle cx="310" cy="150" r="12" fill="#222"/>
  <circle cx="310" cy="150" r="5" fill="#E31E24"/>
  <!-- Text -->
  <text x="200" y="240" font-family="Montserrat, sans-serif" font-size="12" fill="#666" text-anchor="middle">Установка магнитолы</text>
  <text x="200" y="260" font-family="Montserrat, sans-serif" font-size="10" fill="#E31E24" text-anchor="middle">Toyota Camry</text>
</svg>
