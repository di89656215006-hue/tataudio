<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1A1A1A"/>
      <stop offset="100%" style="stop-color:#0D0D0D"/>
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="url(#bg)"/>
  <!-- Headliner -->
  <rect x="50" y="60" width="300" height="160" rx="15" fill="#222"/>
  <!-- Sunroof -->
  <rect x="140" y="90" width="120" height="80" rx="10" fill="#111"/>
  <!-- Dome light -->
  <rect x="180" y="180" width="40" height="20" rx="5" fill="#333"/>
  <rect x="185" y="185" width="30" height="10" rx="3" fill="#E31E24"/>
  <!-- Sound deadening on headliner -->
  <rect x="70" y="80" width="50" height="40" rx="3" fill="#333" stroke="#E31E24" stroke-width="1"/>
  <rect x="280" y="80" width="50" height="40" rx="3" fill="#333" stroke="#E31E24" stroke-width="1"/>
  <!-- Visors -->
  <rect x="70" y="130" width="60" height="30" rx="3" fill="#333"/>
  <rect x="270" y="130" width="60" height="30" rx="3" fill="#333"/>
  <!-- Text -->
  <text x="200" y="245" font-family="Montserrat, sans-serif" font-size="12" fill="#666" text-anchor="middle">Шумоизоляция крыши</text>
  <text x="200" y="265" font-family="Montserrat, sans-serif" font-size="10" fill="#E31E24" text-anchor="middle">Hyundai Santa Fe</text>
</svg>
