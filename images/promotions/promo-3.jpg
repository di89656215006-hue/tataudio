<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1A1A1A"/>
      <stop offset="100%" style="stop-color:#0D0D0D"/>
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="url(#bg)"/>
  <!-- Promo banner -->
  <rect x="50" y="40" width="300" height="160" rx="10" fill="#222"/>
  <!-- Discount badge -->
  <circle cx="100" cy="80" r="35" fill="#E31E24"/>
  <text x="100" y="75" font-family="Montserrat, sans-serif" font-size="18" fill="#fff" text-anchor="middle">-25%</text>
  <text x="100" y="92" font-family="Montserrat, sans-serif" font-size="10" fill="#fff" text-anchor="middle">СКИДКА</text>
  <!-- Text -->
  <text x="250" y="80" font-family="Montserrat, sans-serif" font-size="16" fill="#fff" text-anchor="middle">Шумоизоляция</text>
  <text x="250" y="100" font-family="Montserrat, sans-serif" font-size="16" fill="#fff" text-anchor="middle">полного авто</text>
  <text x="250" y="130" font-family="Montserrat, sans-serif" font-size="12" fill="#666" text-anchor="middle">всего за 25 000 ₽</text>
  <text x="250" y="150" font-family="Montserrat, sans-serif" font-size="12" fill="#666" text-anchor="middle">вместо 35 000 ₽</text>
  <!-- Timer -->
  <rect x="100" y="175" width="200" height="20" rx="3" fill="#111"/>
  <text x="200" y="190" font-family="Montserrat, sans-serif" font-size="10" fill="#E31E24" text-anchor="middle">⏰ До 30 апреля</text>
  <!-- Text -->
  <text x="200" y="240" font-family="Montserrat, sans-serif" font-size="14" fill="#666" text-anchor="middle">Специальное предложение</text>
  <text x="200" y="260" font-family="Montserrat, sans-serif" font-size="12" fill="#E31E24" text-anchor="middle">2026</text>
</svg>
